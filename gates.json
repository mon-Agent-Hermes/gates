{
  "commands": {
    "typecheck": "npm run typecheck",
    "tests": "npm test"
  },
  "requiredCommands": ["typecheck", "tests"],
  "entry": "src/cli.ts",
  "roots": ["src"],
  "deliverables": ["bin/gates.mjs", "src/cli.ts"],
  "probes": [
    {
      "id": "projet-sain-sort-en-0",
      "criterion": "AC-1",
      "kind": "cli",
      "run": "cd fixtures/projet-sain && node ../../bin/gates.mjs check",
      "expect": { "exitCode": 0, "stdout": "/TOUT VERT/" }
    },
    {
      "id": "livrable-injoignable-sort-en-1",
      "criterion": "AC-2",
      "kind": "cli",
      "run": "cd fixtures/projet-casse && node ../../bin/gates.mjs check",
      "expect": { "exitCode": 1, "stdout": "/orphelin\\.mjs/" }
    },
    {
      "id": "sans-config-sort-en-2",
      "criterion": "AC-3",
      "kind": "cli",
      "run": "cd fixtures/projet-sans-config && node ../../bin/gates.mjs check",
      "expect": { "exitCode": 2, "stderr": "/gates\\.json/" }
    },
    {
      "id": "cle-inconnue-sort-en-2",
      "criterion": "AC-4",
      "kind": "cli",
      "run": "cd fixtures/projet-config-invalide && node ../../bin/gates.mjs check",
      "expect": { "exitCode": 2, "stderr": "/clé inconnue « json »/" }
    },
    {
      "id": "sous-github-sortie-protegee-et-annotee",
      "criterion": "AC-5",
      "kind": "cli",
      "run": "node fixtures/sous-github.mjs",
      "expect": { "exitCode": 0, "stdout": "/::stop-commands::[0-9a-f-]{36}[\\s\\S]*::[0-9a-f-]{36}::[\\s\\S]*::notice title=gates etat::/" }
    },
    {
      "id": "page-sans-section-site-les-familles-sont-nommees",
      "criterion": "AC-6",
      "kind": "cli",
      "run": "cd fixtures/site-sans-section && node ../../bin/gates.mjs check",
      "expect": { "exitCode": 0, "stdout": "/a11y[\\s\\S]*section « site »/" }
    },
    {
      "id": "api-json-ne-recoit-pas-le-rappel",
      "criterion": "AC-6",
      "kind": "cli",
      "run": "cd fixtures/api-sans-page && node ../../bin/gates.mjs check",
      "expect": { "exitCode": 0, "stdout": "/^(?![\\s\\S]*a11y)[\\s\\S]*TOUT VERT/" }
    },
    {
      "id": "deux-entrees-posees-par-convention",
      "criterion": "AC-7",
      "kind": "cli",
      "run": "cd fixtures/entrees-multiples && node ../../bin/gates.mjs check",
      "expect": { "exitCode": 0, "stdout": "/tous atteignables depuis src\\/app\\/layout\\.tsx, src\\/app\\/page\\.tsx/" }
    },
    {
      "id": "entree-introuvable-dans-une-liste-reste-nommee",
      "criterion": "AC-7",
      "kind": "cli",
      "run": "cd fixtures/entree-introuvable && node ../../bin/gates.mjs check",
      "expect": { "exitCode": 1, "stdout": "/introuvable[\\s\\S]*src\\/app\\/absente\\.tsx/" }
    },
    {
      "id": "alias-tsconfig-suivi-par-assembly",
      "criterion": "AC-8",
      "kind": "cli",
      "run": "cd fixtures/alias-tsconfig && node ../../bin/gates.mjs check",
      "expect": { "exitCode": 0, "stdout": "/tous atteignables depuis src\\/main\\.ts/" }
    },
    {
      "id": "plan-dit-ce-qui-ne-sera-pas-juge-et-les-regles",
      "criterion": "AC-9",
      "kind": "cli",
      "run": "cd fixtures/site-sans-section && node ../../bin/gates.mjs plan",
      "expect": { "exitCode": 0, "stdout": "/Ce qui ne sera PAS jugé[\\s\\S]*mobile[\\s\\S]*pas de section « site » au contrat[\\s\\S]*mobile:scroll-horizontal/" }
    },
    {
      "id": "plan-refuse-un-contrat-invalide",
      "criterion": "AC-9",
      "kind": "cli",
      "run": "cd fixtures/projet-config-invalide && node ../../bin/gates.mjs plan",
      "expect": { "exitCode": 2, "stderr": "/clé inconnue « json »/" }
    }
  ],
  "coverage": {
    "runtime": "node",
    "requireExecuted": ["src/**/*.ts"],
    "allowUnexecuted": ["src/**/*.test.ts", "src/types.ts"]
  }
}
